<?xml version="1.0"?>
<ruleset name="Site Spell Checker">
	<description>WordPress Coding Standards plus PHP 7.4 compatibility (the plugin's "Requires PHP").</description>
	<file>site-spell-checker.php</file>
	<file>uninstall.php</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="site-spell-checker"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="site_spell_checker"/>
				<element value="SITE_SPELL_CHECKER"/>
			</property>
		</properties>
	</rule>
</ruleset>
